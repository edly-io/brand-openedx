{
  "$type": "color",
  "color": {
    "primary": {
      "100": {
        "source": "$primary-100",
        "modify": [
          {
            "type": "mix",
            "otherColor": "white",
            "amount": "0.94"
          }
        ],
        "actions": {
          "default": "{color.action.default.primary.100}"
        },
        "$value": "{color.primary.base}",
        "$description": "Primary color of level 100."
      },
      "base": {
        "$value": "#0A76DB",
        "source": "$primary",
        "$description": "Basic primary color."
      },
      "light": {
        "$value": "#E8F2FC",
        "source": "$primary-light",
        "$description": "Light primary color."
      }
    },
    "text": {
      "base": {
        "$value": "#333333",
        "source": "$text-color",
        "$description": "Text base color."
      },
      "light": {
        "$value": "#515661",
        "source": "$text-color-light",
        "$description": "Text light color."
      },
      "footer": {
        "$value": "#374151",
        "source": "$light-dark",
        "$description": "Footer text color."
      },
      "primary": {
        "$value": "#515661",
        "source": "$text-color-primary",
        "$description": "Text primary color."
      }
    },
    "brand": {
      "base": {
        "$value": "#0D3F8A",
        "source": "$brand",
        "$description": "Arbisoft dark blue."
      }
    },
    "accent": {
      "a": {
        "base": {
          "$value": "#F37224",
          "source": "$accent-a",
          "$description": "Arbisoft orange accent."
        }
      }
    },
    "success": {
      "base": {
        "$value": "#17824A",
        "source": "$success",
        "$description": "Arbisoft green, success."
      }
    },
    "warning": {
      "base": {
        "$value": "#FFC700",
        "source": "$warning",
        "$description": "Arbisoft yellow, warning."
      }
    }
  },
  "course": {
    "card": {
      "shadow": {
        "$value": "0px 0px 0px 1px rgba(0, 0, 0, 0.15), 0px 4px 6px -2px rgba(0, 0, 0, 0.15), 0px 10px 15px -3px rgba(0, 0, 0, 0.15)",
        "$type": "shadow",
        "source": "$course-card-shadow"
      }
    }
  }
}

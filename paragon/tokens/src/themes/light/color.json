{
  "$type": "color",
  "color": {
    "primary": {
      "100": {
        "source": "$primary-100",
        "modify": [
          {
            "type": "mix",
            "otherColor": "white",
            "amount": "0.94"
          }
        ],
        "actions": {
          "default": "{color.action.default.primary.100}"
        },
        "$value": "{color.primary.base}",
        "$description": "Primary color of level 100."
      },
      "base": {
        "$value": "#DD1F25",
        "source": "$primary",
        "$description": "Basic primary color."
      },
      "light": {
        "$value": "#F4F4F4",
        "source": "$primary-light",
        "$description": "Light primary color."
      }
    },
    "text": {
      "base": {
        "$value": "#252525",
        "source": "$text-color",
        "$description": "Text base color."
      },
      "light": {
        "$value": "#666666",
        "source": "$text-color-light",
        "$description": "Text light color."
      },
      "footer": {
        "$value": "#FFFFFF",
        "source": "$light-dark",
        "$description": "Footer text color."
      },
      "primary": {
        "$value": "#666666",
        "source": "$text-color-primary",
        "$description": "Text primary color."
      }
    },
    "brand": {
      "base": {
        "$value": "#0258ED",
        "source": "$brand",
        "$description": "Edly blue."
      }
    },
    "accent": {
      "a": {
        "base": {
          "$value": "#F59913",
          "source": "$accent-a",
          "$description": "Edly orange accent."
        }
      }
    },
    "success": {
      "base": {
        "$value": "#00AD90",
        "source": "$success",
        "$description": "Edly teal, success."
      }
    },
    "warning": {
      "base": {
        "$value": "#F59913",
        "source": "$warning",
        "$description": "Edly orange, warning."
      }
    },
    "info": {
      "base": {
        "$value": "#0258ED",
        "source": "$info",
        "$description": "Edly blue, info and links."
      }
    },
    "danger": {
      "base": {
        "$value": "#B91C1C",
        "source": "$danger",
        "$description": "Danger red, distinct from the primary red."
      }
    },
    "body": {
      "base": {
        "$value": "#252525",
        "source": "$body-color",
        "$description": "Body text color."
      }
    },
    "headings": {
      "base": {
        "$value": "#252525",
        "source": "$headings-color",
        "$description": "Headings text color."
      }
    },
    "disabled": {
      "$value": "#666666",
      "source": "$disabled",
      "$description": "Disabled element color."
    },
    "btn": {
      "text": {
        "success": {
          "modify": [{ "type": "color-yiq", "dark": "#252525", "threshold": 100 }],
          "$description": "Dark text on Edly teal (white fails contrast)."
        }
      }
    },
    "badge": {
      "text": {
        "success": {
          "modify": [{ "type": "color-yiq", "dark": "#252525", "threshold": 100 }],
          "$description": "Dark text on Edly teal (white fails contrast)."
        }
      }
    }
  },
  "course": {
    "card": {
      "shadow": {
        "$value": "0px 0px 0px 1px rgba(0, 0, 0, 0.15), 0px 4px 6px -2px rgba(0, 0, 0, 0.15), 0px 10px 15px -3px rgba(0, 0, 0, 0.15)",
        "$type": "shadow",
        "source": "$course-card-shadow"
      }
    }
  }
}

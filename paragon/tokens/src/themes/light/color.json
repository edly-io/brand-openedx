{
  "$type": "color",
  "color": {
    "primary": {
      "100": {
        "source": "$primary-100",
        "modify": [
          {
            "type": "mix",
            "otherColor": "white",
            "amount": "0.94"
          }
        ],
        "actions": {
          "default": "{color.action.default.primary.100}"
        },
        "$value": "{color.primary.base}",
        "$description": "Primary color of level 100."
      },
      "base": {
        "$value": "#dd1e26",
        "source": "$primary",
        "$description": "Basic primary color."
      },
      "light": {
        "$value": "#EBF9F6",
        "source": "$primary-light",
        "$description": "Light primary color."
      }
    },
    "text": {
      "base": {
        "$value": "#111827",
        "source": "$text-color",
        "$description": "Text base color."
      },
      "light": {
        "$value": "#515661",
        "source": "$text-color-light",
        "$description": "Text light color."
      },
      "footer": {
        "$value": "#374151",
        "source": "$light-dark",
        "$description": "Footer text color."
      },
      "primary": {
        "$value": "#515661",
        "source": "$text-color-primary",
        "$description": "Text primary color."
      }
    },
    "accent": {
      "a": {
        "$value": "#4DC6B1",
        "$description": "Edly teal accent (edly.io), used for emphasised text, links and active navigation.",
        "source": "$accent-a",
        "actions": {
          "default": "{color.action.default.accent.a}"
        }
      },
      "b": {
        "$value": "#20AD96",
        "$description": "Darker Edly teal, hover state of the accent.",
        "source": "$accent-b",
        "actions": {
          "default": "{color.action.default.accent.b}"
        }
      }
    },
    "link": {
      "base": {
        "$value": "{color.accent.a}"
      },
      "hover": {
        "$value": "{color.accent.b}"
      },
      "inline": {
        "base": {
          "$value": "{color.accent.a}"
        },
        "decoration": {
          "$value": "#4DC6B14D"
        },
        "hover": {
          "base": {
            "$value": "{color.accent.b}"
          },
          "decoration": {
            "$value": "{color.accent.b}"
          }
        }
      }
    }
  },
  "course": {
    "card": {
      "shadow": {
        "$value": "0px 0px 0px 1px rgba(0, 0, 0, 0.15), 0px 4px 6px -2px rgba(0, 0, 0, 0.15), 0px 10px 15px -3px rgba(0, 0, 0, 0.15)",
        "$type": "shadow",
        "source": "$course-card-shadow"
      }
    }
  }
}
